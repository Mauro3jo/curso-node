{
  "name": "node-turnos",
  "version": "1.0.0",
  "private": true,
  "description": "Gestor de turnos en tiempo real con Node, Express y Socket.IO",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "fundamentos": "node ejercicios/01-fundamentos/app.js",
    "tareas": "node ejercicios/02-tareas/cli.js",
    "clima": "node ejercicios/03-clima/cli.js",
    "rest": "node ejercicios/04-rest/server.js",
    "start": "node src/server.js",
    "test": "node --test",
    "check": "node --check src/server.js && node --check src/queue.js && node --check public/app.js"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "cloudinary": "2.11.0",
    "express": "5.3.0",
    "google-auth-library": "11.3.3",
    "jsonwebtoken": "9.0.3",
    "mongoose": "9.12.0",
    "multer": "2.5.0",
    "socket.io": "4.8.4"
  },
  "devDependencies": {
    "mongodb-memory-server": "11.3.0",
    "socket.io-client": "4.8.4"
  }
}
